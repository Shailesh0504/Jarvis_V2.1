  "cards": [
    {
      "dot": "cyan",
      "title": "LAYA CORE: Authoritative Tri-Bridge Orchestration Layer",
      "items": [
        "1. Command direct execute hogi ya nahi: FastPath vs Conversational vs Agent Goal",
        "2. Conversation model ko bhejna hai: Route to Chat/LLM (DualBrain / Qwen / Local Models)",
        "3. Complex task ke liye agent activate karna hai: Route to Agent Planner / Task Graph via AutonomousAgent",
        "4. Kaunsa model use hoga: Deterministic rule fast vs Local Qwen vs Cloud LLM vs Agent Planner",
        "5. Context kitna dena hai: Dynamic context scoping (NONE, MINIMAL, ACTIVE_WINDOW, CONVERSATIONAL, FULL)",
        "6. Memory kab retrieve karni hai: Selective gating for facts/preferences; bypass for tools (<15ms)",
        "7. Confirmation chahiye ya nahi: Risk-gated policy (LOW execute vs HIGH/CRITICAL explicit confirmation)",
        "8. Task successful hua ya nahi: Closed-loop physical verification via ExecutionVerificationLayer",
        "9. Failure par retry/fallback kya hai: Closed-loop fallback strategy (retry_alternate, web_search, clarify)"
      ]
    },
    {
      "dot": "cyan",
      "title": "Primary Execution Pipeline (85%+ Turns)",
      "items": [
        "Voice → STT → FaceAuth Gate → ConversationManager+TurnContext → 10ms Fast Path bypass OR Dialog lock → Speech-Act Gate → SemanticActionExecutor",
        "UniversalTargetEngine resolves desktop apps vs websites vs local files before execution via Win32/Process Strategy",
        "ExecutionStrategy streams conversational ack (<50ms) while async verification completes via ExecutionVerificationLayer",
        "Phase 3.0-B2: Five primary handlers (window, folder, app launch, file, website) each produce a verified ExecutionResult",
        "OutcomeAdapter normalizes ActionOutcome+ExecutionResult → ExecutionOutcomeHook → TurnOutcome stored in TurnContext.execution_outcome"
      ]
    },
    {
      "dot": "emerald",
      "title": "Phase 3.0-B: Closed-Loop Outcome Infrastructure",
      "items": [
        "B1: TurnOutcome + TurnOutcomeStatus (VERIFIED/UNVERIFIED/AMBIGUOUS/FAILED/PARTIAL) + OutcomeAdapter + ExecutionOutcomeHook — zero runtime wiring",
        "B2: OutcomeAdapter+Hook wired into 5 SemanticActionExecutor primary handlers (window/folder/app/file/website)",
        "B3-A: OutcomeAdapter+Hook wired into plugin/fallback path. UNVERIFIED invariant: plugin success=True without real VerificationResult → UNVERIFIED",
        "B3-B: PluginVerificationBridge — maps (service, action) to existing ExecutionVerificationLayer methods. Verifiable: browser/youtube/apps/vlc/excel/windows. All others → UNVERIFIED (not FAILED)",
        "Telemetry emits exactly one execution.outcome event per turn. Learning is policy-gated — no routine success noise"
      ]
    },
    {
      "dot": "rose",
      "title": "Reasoning, Observability & Self-Improvement",
      "items": [
        "AutonomousAgent decomposes multi-step goals into execution graphs via AgentTaskMemory",
        "Knowledge Engine: zero-command-execution GK facts + 6-phase structured IT troubleshooting (Windows 10/11, Server 2019, Azure, Networking)",
        "PipelineLatencyTracker benchmarks every stage (STT, Intent, Exec, TTS) to sub-300ms SLA; Activity Observer polls window/desktop state",
        "Cognitive Memory (Working/Episodic/Semantic/Entity/Correction) persists to ACID WAL SQLite — single authoritative SSOT",
        "5-Layer LearningManager: LogLearner extracts corrections; back-propagates mistake avoidance to TargetDiscovery. Live Update Manager enables zero-downtime hot reloading"
      ]
    }
  ]
}
